+LL_VEC_GEN_BASIC_MATH_FUNC_FLOAT(IsFloatN, cosh)
+LL_VEC_GEN_BASIC_MATH_FUNC_FLOAT(IsFloatN, exp)
+LL_VEC_GEN_BASIC_MATH_FUNC_FLOAT(IsFloatN, fabs)
+LL_VEC_GEN_BASIC_MATH_FUNC_FLOAT(IsFloatN, floor)
