+            return static_cast<std::uint8_t>(std::round(255.0f * std::clamp(component, 0.0f, 1.0f)));
+        };
+
+        return (static_cast<uint>(toByte(a)) << 24) | (static_cast<uint>(toByte(r)) << 16)
+             | (static_cast<uint>(toByte(g)) << 8) | static_cast<uint>(toByte(b));
+    }
 
