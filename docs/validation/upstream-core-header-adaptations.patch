+
+    template <typename F>
+    auto visit(F&& visitor) {
+        return std::visit(std::forward<F>(visitor), variant_);
+    }
+
+    template <typename F>
+    auto visit(F&& visitor) const {
+        return std::visit(std::forward<F>(visitor), variant_);
+    }
+
+private:
+    variant_t variant_;
+};
