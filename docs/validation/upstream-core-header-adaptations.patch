+        auto offset = pos % bits_per_value;
+        if (value) {
+            container_[idx] |= (underlying_type(1) << offset);
+        } else {
+            container_[idx] &= ~(underlying_type(1) << offset);
+        }
+        return static_cast<Derived&>(*this);
+    }
